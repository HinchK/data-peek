# Database (Supabase, Neon, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# DodoPayments
DODO_API_KEY="..."
DODO_WEBHOOK_SECRET="..."
DODO_PRO_PRODUCT_ID="pdt_xxx"

# Resend (Email)
RESEND_API_KEY="re_..."

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Feature clips (optional). Only needed if serving marketing clip video from
# an R2 bucket instead of apps/web/public/clips/ (the committed default).
# NEXT_PUBLIC_CLIP_BASE="https://pub-84538e6ab6f94b80b94b8aa308ad1270.r2.dev/clips"
